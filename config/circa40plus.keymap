#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        Lang1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <17 16>;
        };

        Lang2 {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <21 22>;
        };

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            label = "Base";

            // SW1..6 SW45 | SW22..27
            // SW7..12    | SW46 SW28..32
            // SW13..17 SW43 | SW33..38
            // SW18..21 SW44 | SW49 SW39..42

            bindings = <
&kp TAB    &kp Q         &kp W         &kp E           &kp R        &kp T             &kp ESC                 &kp Y          &kp U        &kp I      &kp O      &kp P        &kp DEL
&kp LCTRL  &kp A         &kp S         &kp D           &kp F        &kp G                        &kp AT_SIGN  &kp H          &kp J        &kp K      &kp L      &kp MINUS
&kp LSHFT  &kp Z         &kp X         &kp C           &kp V        &kp B                        &kp B        &kp N          &kp M        &kp COMMA  &kp DOT    &lt 1 SLASH
           &kp LEFT_ALT  &kp LEFT_GUI  &kp LANGUAGE_1  &lt 1 SPACE  &lt 3 LANGUAGE_2             &kp SPACE    &kp BACKSPACE  &lt 2 ENTER  &mkp LCLK  &mkp RCLK
            >;
        };

        Common {
            bindings = <
&kp LC(F)  &kp LC(A)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(LS(V))  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans     &trans     &trans                   &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans     &trans     &trans                   &trans  &trans  &trans  &trans  &trans  &trans
           &trans     &trans     &trans     &trans     &trans                   &trans  &trans  &trans  &trans  &trans
            >;
        };

        Function {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans             &kp LA(LEFT_ARROW)  &kp UP_ARROW    &kp LA(RIGHT_ARROW)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &kp LC(PAGE_UP)    &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &kp LC(PAGE_DOWN)  &trans              &trans          &trans               &trans
        &trans  &trans  &trans  &trans  &trans            &trans  &trans             &trans              &trans          &trans
            >;
        };

        numbers {
            label = "Num / Nav";
            bindings = <
&kp GRAVE  &kp N1  &kp N2   &kp N3   &kp N4  &kp N5   &kp N6            &kp N6                &kp N7                 &kp N8            &kp N9             &kp N0       &kp DEL
&trans     &kp F1  &kp F2   &kp F3   &kp F4  &kp F5             &trans  &kp PLUS              &kp MINUS              &kp ASTRK         &kp SLASH          &kp AT_SIGN
&trans     &kp F6  &kp F7   &kp F8   &kp F9  &kp F10            &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL
           &trans  &kp F11  &kp F12  &trans  &trans             &trans  &trans                &trans                 &kp HASH          &kp EQUAL
            >;
        };

        mouse {
            label = "Mouse";

            // Auto Mouse Layer 用: trackball_listener の zip_temp_layer から
            // ボール移動時に自動でこのレイヤーへ入る（circa40plus_right.overlay 参照）。
            // J/K/L (position 21/22/23) にクリックを配置。ベースの LCLK/RCLK・
            // systemレイヤーのMCLKはそのまま残しているため、手動アクセスも従来通り可能。

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans     &trans     &trans     &trans
        &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans     &trans     &trans
            >;
        };

        system {
            label = "BT / Media";
            bindings = <
&trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans               &out OUT_USB  &out OUT_BLE  &trans        &trans        &trans       &bt BT_CLR
&bootloader  &sys_reset    &trans        &trans        &trans        &trans                  &trans     &trans        &trans        &trans        &sys_reset    &bootloader
&trans       &trans        &trans        &trans        &trans        &trans                  &trans     &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_MUTE    &trans
             &trans        &trans        &trans        &trans        &trans                  &mkp MCLK  &trans        &trans        &kp C_VOL_DN  &kp C_VOL_UP
            >;
        };
    };
};
